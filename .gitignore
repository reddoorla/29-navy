node_modules
.svelte-kit
.netlify
build

# Env
.env
.env.*
!.env.example

# Local agent config — operator-specific, must not ship with the template.
#
# The exception below is deliberate but currently INERT, and saying so here is
# the point: `~/.config/git/ignore` on the maintainer's machine carries
# `**/.claude/`, which wins, so `.claude/settings.json` still cannot be added
# without `-f`. Removing that global line is an operator decision — it would
# change the default in every repo on the machine, not just this one.
#
# What the exception is FOR: `.claude/settings.json` registers the
# UserPromptSubmit hook at scripts/hooks/reuse-context.mjs, which surfaces the
# matching rows of docs/COMPONENTS.md before an agent starts building behaviour
# this repo already ships. It is strictly additive — it prints context and never
# blocks a tool call — so it is safe to track. Until the global rule goes, the
# hook works for whoever creates the file locally and ships to nobody.
#
# NOTE the trailing `/*`: git cannot re-include a file whose PARENT DIRECTORY is
# excluded, so `.claude/` plus `!.claude/settings.json` would silently keep
# ignoring it. Excluding the directory's CONTENTS is what makes the exception
# reachable at all.
.claude/*
!.claude/settings.json

# OS / editor / test output
.DS_Store
*.log
coverage
playwright-report
test-results
.lighthouseci
.reddoor-a11y
.reddoor-a11y-spec-*

# Agency process artifacts (specs/plans) and local helpers never ship in the
# template. The Blux-era ones stay tracked in reddoor-starter-blux; new specs
# and plans live in reddoor-maintenance.
/docs/superpowers/
/scratchpad/

# canonical entries from @reddoorla/maintenance sync-configs
dist/
.vitest-cache/
.tsbuildinfo

.worktrees/

# reddoor-maint match-harness: scripts + records tracked, workspace ignored
scratch-diff*/
matching/*
!matching/*.sh
!matching/*.mjs
!matching/*.md
# The pause switch. Extensionless on purpose (it is a sentinel, not a doc), so
# the whitelist above misses it — and an ignored switch is not a switch: it
# would work on one machine and be absent from every fresh clone, CI run and
# agent that most needs to see it.
!matching/PAUSED
!matching/spec-sections/
!matching/states/
matching/states/*
!matching/states/*.mjs
# derived artefacts, even where the extensions above would catch them
matching/*.log
matching/*.json
# ...except the page table itself, which is the harness's configuration and the
# one thing a fresh clone cannot reconstruct.
!matching/harness.json
matching/*.png

# end reddoor-maint match-harness
